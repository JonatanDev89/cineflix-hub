# ============================================
# CINEFLIX HUB - ENVIRONMENT VARIABLES
# ============================================
# IMPORTANTE: Copie este arquivo para .env e preencha com suas chaves reais
# NÃO commite o arquivo .env com chaves reais!

# Supabase Configuration (chave anon é pública, OK expor)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_aqui

# TMDB API (MANTER PRIVADA - NÃO EXPOR NO FRONTEND)
# Obtenha sua chave em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_tmdb_aqui

# Mercado Pago (MANTER PRIVADA)
# Obtenha seu token em: https://www.mercadopago.com.br/developers
MP_TOKEN=seu_token_mercadopago_aqui

# Server Configuration
PORT=3000
